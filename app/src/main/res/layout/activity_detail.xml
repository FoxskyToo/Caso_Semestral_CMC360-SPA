<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rack 01 - Sala A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <TextView
            android:id="@+id/tvDetailSubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03/09/2026 - 10:24 | Usuario: B. Pérez"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="16dp" />

        <!-- Imagen del Rack -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivDetailPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#CBD5E1" />
        </androidx.cardview.widget.CardView>

        <!-- Encabezado de Componentes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Componentes declarados"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp" />

        <!-- Lista de Componentes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetailComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Botón Agregar Nuevo Componente -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddDetailComponent"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ Agregar nuevo componente"
            android:textSize="15sp"
            android:textColor="#0066FF"
            app:strokeColor="#0066FF"
            app:cornerRadius="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Sección Información Adicional -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información adicional"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDetailLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Ubicación: Sala A"
                    android:textSize="14sp"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDetailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✔️ Estado: Validado"
                    android:textSize="14sp"
                    android:textColor="#475569" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Volver al Historial -->
        <Button
            android:id="@+id/btnBackFromDetail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Volver al historial"
            android:textSize="15sp"
            android:backgroundTint="#0066FF"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Botón Eliminar Levantamiento (Con el mismo diseño sólido) -->
        <Button
            android:id="@+id/btnDeleteAssessment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Eliminar Levantamiento"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>